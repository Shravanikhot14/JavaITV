package loops;

import java.util.Scanner;

public class Example7 {
	
	public static void main(String[] args) {
		
		Scanner sc=new Scanner(System.in);
		
		System.out.println("Enter no. of times to print:");
		int n= sc.nextInt();
		
		for(int i; i<=n; i++)
		{
			System.out.println("Hello");
		}
		
		
	}

}
