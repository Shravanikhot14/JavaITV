package loops;

public class Example15 {
	
	public static void main(String[] args) {
		
		int n=5;
		
		boolean isPrime=true;
		
		for(int i=2; i<=(n/2); i++)
		{
			if(n%i==0)
			{
				isPrime=false;
				break;
			}
		}
		
		if(isPrime && n!=1)
		{
			System.out.println(n+ " is a Prime number");
		}
		else
		{
			System.out.println(n+ " is Not a prime number");
		}
	}

}
