package arrays;

public class Example8 {
	
	public static void main(String[] args) {
		
		int seats[][]= {{0,0},{1,0},{0,0},{1,1}};
		
		for(int i=0; i<seats.length; i++)
		{
			for(int j=0; j<seats[i].length; j++)
			{
				if(seats[i][j]==0)
					System.out.print("["+i+"]"+"["+j+"]");
				else
					System.out.println("***");
			}
			
			System.out.println();
		}
	}

}
